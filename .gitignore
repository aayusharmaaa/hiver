__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
build/
dist/

# Large data artifacts are regenerated by the pipeline.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
!data/processed/brand_ranking.csv
!data/processed/brand_ranking.json
!data/processed/profile.json
# VirginTrains: keep the small, reviewable artifacts; the parquet tables are regenerated by the pipeline.
!data/processed/virgintrains_case_sample.csv
!data/processed/virgintrains_intent_clusters.json
!data/processed/virgintrains_cluster_preview.json
!data/processed/virgintrains_build_report.json
# Taxonomy calibration: the human labels are a primary artifact and must be versioned.
!data/processed/taxonomy_calibration.csv
!data/processed/taxonomy_calibration_labeling.md
!data/processed/taxonomy_calibration_guide.md
!data/processed/taxonomy_calibration_label_audit.jsonl
!data/processed/taxonomy_calibration_manifest.json
!data/processed/taxonomy_calibration_report.*
!data/processed/splits/
data/processed/splits/*
!data/processed/splits/virgintrains_split_manifest.json
!data/processed/splits/virgintrains_split_assignments.csv
data/processed/_*.log
# The labeling tool's rolling backup and atomic-write temp files are local safety nets, not artifacts.
*.csv.bak
data/processed/.*.tmp
!data/processed/virgintrains_resolution_memory_manifest.json

# Raw Kaggle dump (492 MB) is downloaded by the pipeline, never committed.
/twcs.csv
*.csv.zip
