# Copy to .env (git-ignored) and fill in. Variables already set in your shell take precedence.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: overrides model.name in configs/support_agent.yaml
GEMINI_MODEL=
# Groq backend for the golden intent evaluation (scripts/evaluate_intents.py). Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional: defaults to openai/gpt-oss-120b
GROQ_MODEL=
